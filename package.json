{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=server-dist/server.cjs",
    "prestart": "node -e \"if(!require('fs').existsSync('server-dist/server.cjs')){console.log('[STARTUP] server-dist/server.cjs missing, building...');require('child_process').execSync('npm run build',{stdio:'inherit'})}\"",
    "start": "node -e \"if(!require('fs').existsSync('server-dist/server.cjs')){console.log('[STARTUP] server-dist/server.cjs missing, building...');require('child_process').execSync('npm run build',{stdio:'inherit'})}\" && node server-dist/server.cjs",
    "clean": "rm -rf dist server-dist",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/ws": "^8.18.1",
    "@use-gesture/react": "^10.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.4",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "framer-motion": "^13.4.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.21.0"
  }
}
